#!/usr/bin/env bash
# Developer/installer helper for nixarchy-menu. Production loading is done by
# omarchy-shell; this script only wraps the Omarchy plugin CLI.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ID="$(jq -r .id "$ROOT/manifest.json")"
TARGET="$HOME/.config/omarchy/plugins/$ID"

usage() {
  cat <<USAGE
Usage: bin/nixarchy-menu <command>

  install     Build .#plugin with Nix, validate it, copy it to $TARGET, rescan and enable
  uninstall   Disable, remove the copy, restore the stock Omarchy menu
  enable      omarchy plugin enable $ID
  disable     omarchy plugin disable $ID (restores omarchy.menu)
  dictate     Open Dictate to Clipboard and start recording
  toggle      Toggle the palette (routes through omarchy.menu)
  open <q>    Open the palette with a query
  validate    omarchy plugin validate on this checkout
  check-extensions [dir...]  Check extension folders (extensions/ by default): extension.json, QML lint, unit tests
  test        Run QML, voice lifecycle, time-zone checks, the extension checks, state migration, and qmllint
USAGE
}

# Stage a writable copy of the Nix-built plugin (runtime files only, no
# symlinks, store paths substituted) next to TARGET, so the final mv is atomic.
stage_plugin() {
  local out
  out="$(nix build --no-link --print-out-paths "$ROOT#plugin")"
  mkdir -p "$(dirname "$TARGET")"
  STAGE="$(mktemp -d "$(dirname "$TARGET")/.nixarchy-menu.XXXXXX")"
  cp -r "$out/." "$STAGE"
  chmod -R u+w "$STAGE"
  chmod 755 "$STAGE"  # mktemp -d makes it 0700
}

# nixarchy manages the plugin (programs.nixarchy.defaultPlugins.menu): the
# target is Home Manager's link into the store. A copy would outrank the
# declared pin, and removing it lasts only until the next activation
# (olafkfreund/nixarchy#946).
refuse_if_managed() {
  [[ -L $TARGET && $(readlink -f "$TARGET") == /nix/store/* ]] || return 0
  cat >&2 <<MSG
nixarchy-menu: $TARGET is managed by nixarchy
(programs.nixarchy.defaultPlugins.menu), so '$1' would fight Home Manager.
  - To try a local build: point nixarchy's nixarchy-menu input at this checkout
    (nix build --override-input nixarchy-menu path:$ROOT ...).
  - To go back to a hand install: set defaultPlugins.menu = false, rebuild,
    then run '$0 $1' again.
MSG
  exit 1
}

case "${1:-help}" in
  install)
    refuse_if_managed install
    stage_plugin
    trap 'rm -rf "$STAGE"' EXIT
    omarchy plugin validate "$STAGE"
    # Copy Keystroke's state first. Safe to repeat.
    sh "$STAGE/helpers/migrate-state.sh" || echo "Some Keystroke data was not copied; it is retried when the menu starts." >&2
    if [[ -e $TARGET ]]; then rm -rf "$TARGET"; fi
    mv "$STAGE" "$TARGET"
    trap - EXIT
    omarchy-shell shell rescanPlugins >/dev/null
    for _ in $(seq 1 40); do
      if omarchy-plugin-list --json | jq -e --arg id "$ID" 'any(.[]; .id == $id)' >/dev/null; then break; fi
      sleep 0.05
    done
    # The old evindor.keystroke plugin also claims the menu; disable it first or it keeps the menu. Its files stay.
    if omarchy-plugin-list --json | jq -e 'any(.[]; .id == "evindor.keystroke" and .enabled)' >/dev/null; then
      omarchy plugin disable evindor.keystroke
      echo "Disabled evindor.keystroke (its files are kept in ~/.config/omarchy/plugins/evindor.keystroke)."
    fi
    omarchy plugin enable "$ID" left --index 0
    echo "nixarchy-menu is now the Omarchy menu. Super+Space and every omarchy-menu caller route to it."
    ;;
  uninstall)
    refuse_if_managed uninstall
    omarchy plugin disable "$ID" || true
    rm -rf "$TARGET"
    omarchy-shell shell rescanPlugins >/dev/null
    echo "Removed $TARGET; the stock Omarchy menu is active again."
    ;;
  enable) omarchy plugin enable "$ID" left --index 0 ;;
  disable) omarchy plugin disable "$ID" ;;
  dictate) exec omarchy-shell shell summon omarchy.menu '{"scope":"dictation","title":"Dictate to Clipboard","dictate":true}' ;;
  toggle) exec omarchy-shell shell toggle omarchy.menu '{"menu":"root"}' ;;
  open)
    shift
    exec omarchy-shell shell summon omarchy.menu "$(jq -nc --arg q "${*:-}" '{query: $q}')"
    ;;
  validate) exec omarchy plugin validate "$ROOT" ;;
  check-extensions) shift; exec python3 "$ROOT/tools/check_extensions.py" "$@" ;;
  test)
    if ! command -v qmltestrunner >/dev/null || ! command -v qmllint >/dev/null; then echo "qmltestrunner/qmllint not on PATH; run inside nix develop" >&2; exit 1; fi
    : "${OMARCHY_PATH:=/run/current-system/sw/share/omarchy}"
    export OMARCHY_PATH
    (cd "$ROOT/tests" && qmltestrunner -silent -input .)
    python3 "$ROOT/tests/applications_check.py"
    python3 "$ROOT/tests/files_check.py"
    python3 "$ROOT/tests/catalog_check.py"
    python3 "$ROOT/tests/matching_session_check.py"
    python3 "$ROOT/tests/palette_matching_check.py"
    python3 "$ROOT/tests/palette_shortcut_check.py"
    python3 "$ROOT/tests/palette_dmenu_check.py"
    python3 "$ROOT/tests/palette_route_check.py"
    python3 "$ROOT/tests/palette_motion_check.py"
    python3 "$ROOT/tests/palette_geometry_check.py"
    engine="$(nix build --no-link --print-out-paths "$ROOT#matching-engine")"
    model="$(nix build --no-link --print-out-paths "$ROOT#model-small")"
    python3 "$ROOT/tests/matching_engine_check.py" --engine "$engine/bin/keystroke-matching" --model-dir "$model"
    python3 "$ROOT/tests/voice_session_check.py"
    python3 "$ROOT/tests/clipboard_transfer_check.py"
    python3 "$ROOT/tests/palette_dictation_check.py"
    python3 "$ROOT/tests/tz_helper_check.py"
    python3 "$ROOT/tests/palette_extensions_check.py"
    python3 "$ROOT/tests/palette_currency_check.py"
    python3 "$ROOT/tests/palette_commands_check.py"
    python3 "$ROOT/tests/palette_url_check.py"
    python3 "$ROOT/tests/palette_config_settle_check.py"
    python3 "$ROOT/tools/check_extensions.py"
    python3 "$ROOT/tests/hotkeys_check.py"
    python3 "$ROOT/tests/migrate_state_check.py"
    python3 "$ROOT/tests/install_guard_check.py"
    "$ROOT/tests/lint.sh"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
