{
  "schemaVersion": 1,
  "id": "nixarchy.menu",
  "name": "nixarchy-menu",
  "version": "1.4.4",
  "author": "olafkfreund",
  "license": "MIT",
  "description": "A Raycast-style command palette that replaces the Omarchy menu on nixarchy, with voice, Codex and community extensions",
  "homepage": "https://github.com/olafkfreund/nixarchy-menu",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "NixarchyMenu.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "nixarchy-menu",
    "description": "Opens the nixarchy-menu command palette",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left"
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  }
}
